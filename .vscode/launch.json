{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "attach",
        "name": "Docker: Nodemon Debug",
        "port": 9229,
        "restart": true,
        "localRoot": "${workspaceFolder}",
        "remoteRoot": "/app",
        "sourceMaps": true
      },
      {
        "type": "node",
        "request": "attach",
        "name": "Local: Nodemon Debug",
        "port": 3000,
        "address": "localhost",
        "restart": true,
        "localRoot": "${workspaceFolder}",
        "sourceMaps": true
      }
    ]
  }